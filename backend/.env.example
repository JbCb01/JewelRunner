# Skopiuj do .env i uzupełnij hasło. Pliku .env nie dodawaj do repozytorium.
DATABASE_URL=postgresql+psycopg://jewelrunner:HASLO@localhost:5432/jewelrunner
# Adresy portalu rozdzielone przecinkami. Gwiazdka nie jest dozwolona, bo API używa cookies.
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
# Czas ważności sesji w godzinach
SESSION_TTL_HOURS=168
# lax wystarcza, gdy portal i API są w tej samej domenie; inaczej none (wymaga HTTPS)
SESSION_COOKIE_SAMESITE=lax
# Folder ze zbudowanym portalem (tylko we wdrożeniu); lokalnie portal działa przez Vite
PORTAL_DIST=
# Adres portalu używany w linkach z wiadomości e-mail
PORTAL_URL=http://localhost:5173
# console wypisuje wiadomość w logu serwera (tylko lokalnie), acs wysyła przez Azure Communication Services, none wyłącza wysyłkę
EMAIL_BACKEND=console
# Tylko dla acs; wartości ustawia skrypt deploy/email.sh
ACS_CONNECTION_STRING=
EMAIL_SENDER=
